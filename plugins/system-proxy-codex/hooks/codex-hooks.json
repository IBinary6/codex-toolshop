{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/js/run-python.js\" session_start",
            "timeout": 45,
            "statusMessage": "Configuring Codex system proxy support"
          }
        ]
      }
    ]
  }
}
