{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/run-hook.cjs\" session_start",
            "timeout": 10,
            "statusMessage": "Checking BugDB Python support"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/run-hook.cjs\" post_tool_use",
            "timeout": 5,
            "statusMessage": "Searching BugDB for known errors"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/run-hook.cjs\" user_prompt_submit",
            "timeout": 5,
            "statusMessage": "Checking BugDB guidance"
          }
        ]
      }
    ]
  }
}
