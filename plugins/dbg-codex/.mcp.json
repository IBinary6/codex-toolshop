{
  "mcpServers": {
    "dbg-x64dbg": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/launch.cjs",
        "mcp",
        "x64dbg"
      ],
      "cwd": ".",
      "startup_timeout_sec": 1200
    },
